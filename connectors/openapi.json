{
  "swagger": "2.0",
  "info": {
    "title": "DB Migration Assessment Hub",
    "description": "Connects Power Apps to the DB Migration Readiness Assessment Hub. Supports questionnaire-based assessment, live data collection via registered agents, and report retrieval.",
    "version": "2.0.0"
  },
  "host": "localhost:8000",
  "basePath": "/",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key"
    }
  },
  "security": [{ "apiKey": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "HealthCheck",
        "x-ms-visibility": "internal",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "version": { "type": "string" },
                "timestamp": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/questionnaire": {
      "get": {
        "summary": "Get Assessment Questionnaire",
        "operationId": "GetQuestionnaire",
        "x-ms-visibility": "important",
        "responses": { "200": { "description": "Questionnaire", "schema": { "type": "object" } } }
      }
    },
    "/migration-paths": {
      "get": {
        "summary": "Get Migration Paths",
        "operationId": "GetMigrationPaths",
        "x-ms-visibility": "important",
        "responses": { "200": { "description": "Migration paths", "schema": { "type": "array", "items": { "type": "object" } } } }
      }
    },
    "/assess": {
      "post": {
        "summary": "Start Assessment",
        "operationId": "StartAssessment",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/AssessmentRequest" } }],
        "responses": { "202": { "description": "Queued", "schema": { "$ref": "#/definitions/AssessmentResponse" } } }
      }
    },
    "/status/{jobId}": {
      "get": {
        "summary": "Get Assessment Status",
        "operationId": "GetAssessmentStatus",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "path", "name": "jobId", "type": "string", "required": true }],
        "responses": { "200": { "description": "Status", "schema": { "$ref": "#/definitions/JobStatus" } } }
      }
    },
    "/report/{jobId}": {
      "get": {
        "summary": "Get Assessment Report",
        "operationId": "GetAssessmentReport",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "path", "name": "jobId", "type": "string", "required": true }],
        "responses": { "200": { "description": "Report", "schema": { "type": "array", "items": { "type": "object" } } } }
      }
    },
    "/agents": {
      "get": {
        "summary": "List Agents",
        "operationId": "ListAgents",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "query", "name": "role", "type": "string", "required": false }],
        "responses": { "200": { "description": "Agents", "schema": { "type": "array", "items": { "$ref": "#/definitions/AgentRecord" } } } }
      }
    },
    "/collect": {
      "post": {
        "summary": "Create Collection Job",
        "operationId": "CreateCollectionJob",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/CreateCollectionJobRequest" } }],
        "responses": { "202": { "description": "Created", "schema": { "type": "object" } } }
      },
      "get": {
        "summary": "List Collection Jobs",
        "operationId": "ListCollectionJobs",
        "x-ms-visibility": "important",
        "parameters": [
          { "in": "query", "name": "status", "type": "string", "required": false },
          { "in": "query", "name": "role", "type": "string", "required": false }
        ],
        "responses": { "200": { "description": "Jobs", "schema": { "type": "array", "items": { "$ref": "#/definitions/CollectionJob" } } } }
      }
    },
    "/collect/{jobId}": {
      "get": {
        "summary": "Get Collection Job",
        "operationId": "GetCollectionJob",
        "x-ms-visibility": "important",
        "parameters": [{ "in": "path", "name": "jobId", "type": "string", "required": true }],
        "responses": { "200": { "description": "Job", "schema": { "$ref": "#/definitions/CollectionJob" } } }
      }
    }
  },
  "definitions": {
    "DatabaseEntry": {
      "type": "object",
      "required": ["DatabaseName","SourceType","SourceVersion","SourceEnvironment","MaxDowntime","Connectivity","LandingZone","DataSize","TeamSkill","RollbackPlan"],
      "properties": {
        "DatabaseName":      { "type": "string" },
        "SourceType":        { "type": "string", "enum": ["SQL Server","Oracle","PostgreSQL","MySQL","MariaDB","MongoDB","Cassandra","SybaseASE"] },
        "SourceVersion":     { "type": "string" },
        "SourceEnvironment": { "type": "string", "enum": ["OnPrem","AzureVM","AzureVM_Windows","AzureVM_Linux","AzureArc","AzurePaaS_SingleServer","AzurePaaS_MariaDB","ODAA","OracleCloud","AWS_EC2","AWS_RDS","AWS_Aurora","AWS_DocumentDB","GCP_CloudSQL","GCP_GCE"] },
        "TargetType":        { "type": "string", "default": "Undecided" },
        "MaxDowntime":       { "type": "string", "enum": ["zero","hours","days"] },
        "Connectivity":      { "type": "string", "enum": ["expressroute","vpn","internet","none"] },
        "LandingZone":       { "type": "string", "enum": ["yes","partial","no"] },
        "DataSize":          { "type": "string", "enum": ["small","medium","large"] },
        "StoredProcs":       { "type": "string", "enum": ["none","few","many","extensive"], "default": "none" },
        "Dependencies":      { "type": "string", "default": "" },
        "SpecialFeatures":   { "type": "string", "default": "" },
        "TeamSkill":         { "type": "string", "enum": ["expert","moderate","beginner"] },
        "RollbackPlan":      { "type": "string", "enum": ["yes_tested","yes_untested","partial","no"] },
        "DatabaseCount":     { "type": "integer", "default": 1 }
      }
    },
    "AssessmentRequest": {
      "type": "object",
      "required": ["customerName","requestedBy","databases"],
      "properties": {
        "customerName": { "type": "string" },
        "requestedBy":  { "type": "string" },
        "databases":    { "type": "array", "items": { "$ref": "#/definitions/DatabaseEntry" } },
        "runInfoGather": { "type": "boolean", "default": false }
      }
    },
    "AssessmentResponse": {
      "type": "object",
      "properties": {
        "jobId": { "type": "string" }, "status": { "type": "string" },
        "message": { "type": "string" }, "statusUrl": { "type": "string" }
      }
    },
    "JobStatus": {
      "type": "object",
      "properties": {
        "jobId": { "type": "string" }, "status": { "type": "string" },
        "createdAt": { "type": "string" }, "completedAt": { "type": "string" },
        "customerName": { "type": "string" }, "dbCount": { "type": "integer" },
        "reportUrl": { "type": "string" }, "dataverseRecordId": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "AgentRecord": {
      "type": "object",
      "properties": {
        "agentId": { "type": "string" }, "name": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["online","offline","busy"] },
        "hostname": { "type": "string" }, "version": { "type": "string" },
        "registeredAt": { "type": "string" }, "lastHeartbeat": { "type": "string" },
        "activeJobCount": { "type": "integer" }
      }
    },
    "CreateCollectionJobRequest": {
      "type": "object",
      "required": ["role","databaseName","host"],
      "properties": {
        "role":             { "type": "string", "enum": ["sqlserver","oracle","postgresql","mysql","mariadb","mongodb","cassandra"] },
        "databaseName":     { "type": "string" },
        "host":             { "type": "string" },
        "port":             { "type": "integer" },
        "username":         { "type": "string" },
        "password":         { "type": "string", "format": "password" },
        "additionalParams": { "type": "object" },
        "assessmentJobId":  { "type": "string" }
      }
    },
    "CollectionJob": {
      "type": "object",
      "properties": {
        "jobId": { "type": "string" }, "assessmentJobId": { "type": "string" },
        "role": { "type": "string" }, "databaseName": { "type": "string" },
        "host": { "type": "string" }, "port": { "type": "integer" },
        "username": { "type": "string" }, "status": { "type": "string" },
        "assignedAgentId": { "type": "string" },
        "createdAt": { "type": "string" }, "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }, "error": { "type": "string" }
      }
    }
  }
}
