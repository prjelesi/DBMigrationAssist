# Copy to .env and replace before running Docker Compose.
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Used only when the application user table is empty. Existing users are never overwritten.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
APP_ADMIN_DISPLAY_NAME=Administrator

# Shared only by the API and background worker. Generate with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
WORKER_SERVICE_TOKEN=replace-with-a-random-32-byte-base64-token
