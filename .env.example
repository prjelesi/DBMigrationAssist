# Copy to .env and replace before running Docker Compose.
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Microsoft Entra authentication is disabled for local development by default.
# To enable it, create API and SPA app registrations and fill in all values.
AUTHENTICATION_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=
